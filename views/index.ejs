<!DOCTYPE html>
<html lang="fr">
<head>
  <title>Amandine Habrioux — Architecte</title>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/nav') %>
  <main>
    <% if (projects && projects.length > 0) { %>
      <div class="project-list">
        <% projects.forEach((p, i) => { %>
          <a class="project-row" href="/projet/<%= p.id %>">
            <span class="project-row-index"><%= String(i + 1).padStart(2, '0') %> — <%= String(projects.length).padStart(2, '0') %></span>
            <% if (p.image_url) { %>
              <img src="<%= p.image_url %>" alt="<%= p.titre %>" loading="lazy" />
            <% } else { %>
              <div class="project-row-noimage"></div>
            <% } %>
            <div class="project-row-title">
              <h2><%= p.titre %></h2>
            </div>
          </a>
        <% }) %>
      </div>
    <% } else { %>
      <div class="empty-state">Aucun projet publié pour le moment.</div>
    <% } %>
  </main>
</body>
</html>
