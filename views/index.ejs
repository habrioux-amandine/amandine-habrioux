<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <title>Amandine Habrioux — Architecte</title>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/nav') %>
  <main>
    <% if (heroSlides && heroSlides.length > 0) { %>
      <section class="hero-slideshow" id="heroSlideshow" data-speed="<%= heroSpeed %>">
        <% heroSlides.forEach((s, i) => { %>
          <img
            class="hero-slide <%= i === 0 ? 'active' : '' %>"
            src="<%= s.url %>"
            alt=""
            <% if (i === 0) { %>fetchpriority="high"<% } else { %>loading="lazy"<% } %>
          />
        <% }) %>
      </section>
    <% } %>
    <% if (projects && projects.length > 0) { %>
      <div class="project-list">
        <% projects.forEach((p, i) => { %>
          <a class="project-row" href="/projet/<%= p.id %>">
            <span class="project-row-index"><%= String(i + 1).padStart(2, '0') %> — <%= String(projects.length).padStart(2, '0') %></span>
            <% if (p.image_url) { %>
              <img src="<%= p.image_url %>" alt="<%= pick(p, 'titre') %>" loading="lazy" />
            <% } else { %>
              <div class="project-row-noimage"></div>
            <% } %>
            <div class="project-row-title">
              <h2><%= pick(p, 'titre') %></h2>
            </div>
          </a>
        <% }) %>
      </div>
    <% } else { %>
      <div class="empty-state"><%= t('home.empty') %></div>
    <% } %>
  </main>
  <script src="/js/hero.js"></script>
</body>
</html>
