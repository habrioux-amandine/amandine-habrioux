<!DOCTYPE html>
<html lang="fr">
<head>
  <title><%= project ? 'Modifier le projet' : 'Nouveau projet' %></title>
  <%- include('../partials/head') %>
</head>
<body>
  <main>
    <div class="admin-shell">
      <div class="admin-header">
        <h1><%= project ? 'Modifier le projet' : 'Nouveau projet' %></h1>
        <a href="/admin" class="btn btn-quiet">← Retour</a>
      </div>

      <form method="POST" enctype="multipart/form-data"
        action="<%= project ? '/admin/projets/' + project.id : '/admin/projets/nouveau' %>">

        <div class="form-group">
          <label for="titre">Titre</label>
          <input type="text" id="titre" name="titre" required value="<%= project ? project.titre : '' %>" />
        </div>

        <div class="form-group">
          <label for="sous_titre">Sous-titre</label>
          <input type="text" id="sous_titre" name="sous_titre" value="<%= project && project.sous_titre ? project.sous_titre : '' %>" />
        </div>

        <div class="form-group">
          <label for="description">Description</label>
          <textarea id="description" name="description"><%= project && project.description ? project.description : '' %></textarea>
        </div>

        <details class="lang-section">
          <summary>🇬🇧 English</summary>
          <div class="form-group">
            <label for="titre_en">Title</label>
            <input type="text" id="titre_en" name="titre_en" value="<%= project && project.titre_en ? project.titre_en : '' %>" />
          </div>
          <div class="form-group">
            <label for="sous_titre_en">Subtitle</label>
            <input type="text" id="sous_titre_en" name="sous_titre_en" value="<%= project && project.sous_titre_en ? project.sous_titre_en : '' %>" />
          </div>
          <div class="form-group">
            <label for="description_en">Description</label>
            <textarea id="description_en" name="description_en"><%= project && project.description_en ? project.description_en : '' %></textarea>
          </div>
        </details>

        <details class="lang-section">
          <summary>🇮🇹 Italiano</summary>
          <div class="form-group">
            <label for="titre_it">Titolo</label>
            <input type="text" id="titre_it" name="titre_it" value="<%= project && project.titre_it ? project.titre_it : '' %>" />
          </div>
          <div class="form-group">
            <label for="sous_titre_it">Sottotitolo</label>
            <input type="text" id="sous_titre_it" name="sous_titre_it" value="<%= project && project.sous_titre_it ? project.sous_titre_it : '' %>" />
          </div>
          <div class="form-group">
            <label for="description_it">Descrizione</label>
            <textarea id="description_it" name="description_it"><%= project && project.description_it ? project.description_it : '' %></textarea>
          </div>
        </details>

        <div class="form-row">
          <div class="form-group">
            <label for="ordre_affichage">Ordre d'affichage</label>
            <input type="number" id="ordre_affichage" name="ordre_affichage" value="<%= project ? project.ordre_affichage : 0 %>" />
          </div>
          <div class="form-group">
            <label>Statut</label>
            <div class="form-checkbox">
              <input type="checkbox" id="published" name="published" <%= (!project || project.published) ? 'checked' : '' %> />
              <label for="published" style="margin:0; text-transform:none; font-family:var(--font-body);">Publié sur le site</label>
            </div>
          </div>
        </div>

        <div class="form-group">
          <label for="image_couverture">Schéma affiché sur l'accueil (survolé avant d'accéder au projet)</label>
          <% if (project && project.image_url) { %>
            <img src="<%= project.image_url %>" style="width:220px; height:auto; margin-bottom:10px;" alt="" />
          <% } %>
          <input type="file" id="image_couverture" name="image_couverture" accept="image/*" />
        </div>

        <button type="submit" class="btn"><%= project ? 'Enregistrer' : 'Créer le projet' %></button>
      </form>

      <% if (project) { %>
        <hr style="margin:48px 0; border:none; border-top:1px solid var(--color-line);" />

        <h2 style="margin-bottom:8px;">Galerie du projet</h2>
        <p style="color:var(--color-text-soft); font-size:0.9rem;">Ces images s'affichent dans le slide à droite sur la page du projet.</p>

        <form method="POST" action="/admin/projets/<%= project.id %>/images" enctype="multipart/form-data" style="margin-top:20px;">
          <div class="form-group">
            <label for="images">Ajouter des images</label>
            <input type="file" id="images" name="images" accept="image/*" multiple />
          </div>
          <button type="submit" class="btn btn-quiet">Ajouter à la galerie</button>
        </form>

        <div class="admin-gallery-grid">
          <% gallery.forEach((img) => { %>
            <div class="admin-gallery-item">
              <img src="<%= img.url %>" alt="" />
              <form method="POST" action="/admin/projets/<%= project.id %>/images/<%= img.id %>/supprimer">
                <button type="submit">✕</button>
              </form>
            </div>
          <% }) %>
        </div>

        <hr style="margin:48px 0; border:none; border-top:1px solid var(--color-line);" />
        <form method="POST" action="/admin/projets/<%= project.id %>/supprimer"
          onsubmit="return confirm('Supprimer définitivement ce projet et toutes ses images ?');">
          <button type="submit" class="btn" style="border-color:#a12b2b; color:#a12b2b;">Supprimer ce projet</button>
        </form>
      <% } %>
    </div>
  </main>
</body>
</html>
