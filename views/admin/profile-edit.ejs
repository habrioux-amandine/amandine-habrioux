<!DOCTYPE html>
<html lang="fr">
<head>
  <title>Éditer le profil</title>
  <%- include('../partials/head') %>
</head>
<body>
  <main>
    <div class="admin-shell">
      <div class="admin-header">
        <h1>Profil</h1>
        <a href="/admin" class="btn btn-quiet">← Retour</a>
      </div>

      <form method="POST" action="/admin/profil" enctype="multipart/form-data">
        <div class="form-group">
          <label for="photo">Photo</label>
          <% if (profile.photo_url) { %>
            <img src="<%= profile.photo_url %>" style="width:180px; height:auto; margin-bottom:10px;" alt="" />
          <% } %>
          <input type="file" id="photo" name="photo" accept="image/*" />
        </div>

        <div class="form-group">
          <label for="texte">Texte (CV allégé)</label>
          <textarea id="texte" name="texte" style="min-height:280px;"><%= profile.texte || '' %></textarea>
        </div>

        <details class="lang-section">
          <summary>🇬🇧 English</summary>
          <div class="form-group">
            <label for="texte_en">Text</label>
            <textarea id="texte_en" name="texte_en" style="min-height:200px;"><%= profile.texte_en || '' %></textarea>
          </div>
        </details>

        <details class="lang-section">
          <summary>🇮🇹 Italiano</summary>
          <div class="form-group">
            <label for="texte_it">Testo</label>
            <textarea id="texte_it" name="texte_it" style="min-height:200px;"><%= profile.texte_it || '' %></textarea>
          </div>
        </details>

        <button type="submit" class="btn">Enregistrer</button>
      </form>
    </div>
<hr style="margin:48px 0; border:none; border-top:1px solid var(--color-line);" />

<h2 style="margin-bottom:8px;">Expériences professionnelles</h2>
<p style="color:var(--color-text-soft); font-size:0.9rem; margin-bottom:8px;">
  Classées par ordre chronologique. Utilisez les flèches pour réordonner.
</p>

<div class="experience-list">
  <% experiences.forEach((exp, index) => { %>
    <div class="experience-item">
      <div class="experience-move">
        <form method="POST" action="/admin/profil/experiences/<%= exp.id %>/monter">
          <button type="submit" class="experience-move-btn" <%= index === 0 ? 'disabled' : '' %>>↑</button>
        </form>
        <form method="POST" action="/admin/profil/experiences/<%= exp.id %>/descendre">
          <button type="submit" class="experience-move-btn" <%= index === experiences.length - 1 ? 'disabled' : '' %>>↓</button>
        </form>
      </div>

      <form method="POST" action="/admin/profil/experiences/<%= exp.id %>/supprimer"
        onsubmit="return confirm('Supprimer cette expérience ?');" class="experience-delete">
        <button type="submit">✕</button>
      </form>

      <form method="POST" action="/admin/profil/experiences/<%= exp.id %>">
        <div class="form-row">
          <div class="form-group">
            <label for="periode-<%= exp.id %>">Période</label>
            <input type="text" id="periode-<%= exp.id %>" name="periode" value="<%= exp.periode || '' %>" placeholder="2019 — 2022" />
          </div>
          <div class="form-group">
            <label for="poste-<%= exp.id %>">Poste</label>
            <input type="text" id="poste-<%= exp.id %>" name="poste" required value="<%= exp.poste || '' %>" />
          </div>
          <div class="form-group">
            <label for="structure-<%= exp.id %>">Structure</label>
            <input type="text" id="structure-<%= exp.id %>" name="structure" value="<%= exp.structure || '' %>" />
          </div>
        </div>
        <div class="form-group">
          <label for="description-<%= exp.id %>">Description</label>
          <textarea id="description-<%= exp.id %>" name="description" style="min-height:80px;"><%= exp.description || '' %></textarea>
        </div>

        <details class="lang-section">
          <summary>🇬🇧 English</summary>
          <div class="form-row">
            <div class="form-group">
              <label for="periode_en-<%= exp.id %>">Period</label>
              <input type="text" id="periode_en-<%= exp.id %>" name="periode_en" value="<%= exp.periode_en || '' %>" />
            </div>
            <div class="form-group">
              <label for="poste_en-<%= exp.id %>">Position</label>
              <input type="text" id="poste_en-<%= exp.id %>" name="poste_en" value="<%= exp.poste_en || '' %>" />
            </div>
            <div class="form-group">
              <label for="structure_en-<%= exp.id %>">Company</label>
              <input type="text" id="structure_en-<%= exp.id %>" name="structure_en" value="<%= exp.structure_en || '' %>" />
            </div>
          </div>
          <div class="form-group">
            <label for="description_en-<%= exp.id %>">Description</label>
            <textarea id="description_en-<%= exp.id %>" name="description_en" style="min-height:80px;"><%= exp.description_en || '' %></textarea>
          </div>
        </details>

        <details class="lang-section">
          <summary>🇮🇹 Italiano</summary>
          <div class="form-row">
            <div class="form-group">
              <label for="periode_it-<%= exp.id %>">Periodo</label>
              <input type="text" id="periode_it-<%= exp.id %>" name="periode_it" value="<%= exp.periode_it || '' %>" />
            </div>
            <div class="form-group">
              <label for="poste_it-<%= exp.id %>">Ruolo</label>
              <input type="text" id="poste_it-<%= exp.id %>" name="poste_it" value="<%= exp.poste_it || '' %>" />
            </div>
            <div class="form-group">
              <label for="structure_it-<%= exp.id %>">Azienda</label>
              <input type="text" id="structure_it-<%= exp.id %>" name="structure_it" value="<%= exp.structure_it || '' %>" />
            </div>
          </div>
          <div class="form-group">
            <label for="description_it-<%= exp.id %>">Descrizione</label>
            <textarea id="description_it-<%= exp.id %>" name="description_it" style="min-height:80px;"><%= exp.description_it || '' %></textarea>
          </div>
        </details>

        <button type="submit" class="btn btn-quiet">Enregistrer</button>
      </form>
    </div>
  <% }) %>
</div>

<h3 style="margin:32px 0 8px;">Ajouter une expérience</h3>
<form method="POST" action="/admin/profil/experiences">
  <div class="form-row">
    <div class="form-group">
      <label for="new-periode">Période</label>
      <input type="text" id="new-periode" name="periode" placeholder="2019 — 2022" />
    </div>
    <div class="form-group">
      <label for="new-poste">Poste</label>
      <input type="text" id="new-poste" name="poste" required />
    </div>
    <div class="form-group">
      <label for="new-structure">Structure</label>
      <input type="text" id="new-structure" name="structure" />
    </div>
  </div>
  <div class="form-group">
    <label for="new-description">Description</label>
    <textarea id="new-description" name="description"></textarea>
  </div>

  <details class="lang-section">
    <summary>🇬🇧 English</summary>
    <div class="form-row">
      <div class="form-group">
        <label for="new-periode_en">Period</label>
        <input type="text" id="new-periode_en" name="periode_en" />
      </div>
      <div class="form-group">
        <label for="new-poste_en">Position</label>
        <input type="text" id="new-poste_en" name="poste_en" />
      </div>
      <div class="form-group">
        <label for="new-structure_en">Company</label>
        <input type="text" id="new-structure_en" name="structure_en" />
      </div>
    </div>
    <div class="form-group">
      <label for="new-description_en">Description</label>
      <textarea id="new-description_en" name="description_en"></textarea>
    </div>
  </details>

  <details class="lang-section">
    <summary>🇮🇹 Italiano</summary>
    <div class="form-row">
      <div class="form-group">
        <label for="new-periode_it">Periodo</label>
        <input type="text" id="new-periode_it" name="periode_it" />
      </div>
      <div class="form-group">
        <label for="new-poste_it">Ruolo</label>
        <input type="text" id="new-poste_it" name="poste_it" />
      </div>
      <div class="form-group">
        <label for="new-structure_it">Azienda</label>
        <input type="text" id="new-structure_it" name="structure_it" />
      </div>
    </div>
    <div class="form-group">
      <label for="new-description_it">Descrizione</label>
      <textarea id="new-description_it" name="description_it"></textarea>
    </div>
  </details>

  <button type="submit" class="btn">Ajouter</button>
</form>
  </main>
</body>
</html>
