<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <title><%= t('meta.contact.title') %></title>
  <meta name="description" content="<%= t('meta.contact.desc') %>" />
<meta property="og:type" content="website" />
  <meta property="og:url" content="https://amandine-habrioux.onrender.com/contact" />
  <meta property="og:title" content="<%= t('meta.contact.title') %>" />
  <meta property="og:description" content="<%= t('meta.contact.desc') %>" />
  <meta property="og:image" content="https://amandine-habrioux.onrender.com/images/og-default.png" />
  <meta name="twitter:card" content="summary_large_image" />
  <script type="application/ld+json">
  <%- JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ProfessionalService",
    "name": "Amandine Habrioux — Architecte",
    "email": contact.email || undefined,
    "telephone": contact.telephone || undefined,
    "address": contact.adresse || undefined,
    "url": "https://amandine-habrioux.onrender.com"
  }) %>
  </script>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/nav') %>
  <main>
    <div class="contact-page">
      <h1><%= t('contact.title') %></h1>
      <ul class="contact-list">
        <% if (contact.email) { %>
          <li><span class="contact-label"><%= t('contact.email') %></span><span class="contact-value"><a href="mailto:<%= contact.email %>"><%= contact.email %></a></span></li>
        <% } %>
        <% if (contact.telephone) { %>
          <li><span class="contact-label"><%= t('contact.telephone') %></span><span class="contact-value"><%= contact.telephone %></span></li>
        <% } %>
        <% if (contact.adresse) { %>
          <li><span class="contact-label"><%= t('contact.adresse') %></span><span class="contact-value"><%= contact.adresse %></span></li>
        <% } %>
        <% if (contact.instagram) { %>
          <li><span class="contact-label"><%= t('contact.instagram') %></span><span class="contact-value"><%= contact.instagram %></span></li>
        <% } %>
        <% if (contact.linkedin) { %>
          <li><span class="contact-label"><%= t('contact.linkedin') %></span><span class="contact-value"><%= contact.linkedin %></span></li>
        <% } %>
        <% if (contact.autre) { %>
          <li><span class="contact-label"><%= t('contact.autre') %></span><span class="contact-value"><%= contact.autre %></span></li>
        <% } %>
     </ul>

      <button type="button" id="share-btn" class="share-btn" data-copied-text="<%= t('contact.share.copied') %>">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 12v7a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-7" />
          <polyline points="16 6 12 2 8 6" />
          <line x1="12" y1="2" x2="12" y2="15" />
        </svg>
        <span class="share-label"><%= t('contact.share') %></span>
      </button>
    </div>
  </main>
  <script src="/js/share.js"></script>
</body>
</html>