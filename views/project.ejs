<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <title><%= pick(project, 'titre') %> — Amandine Habrioux, Architecte</title>
  <meta name="description" content="<%= (pick(project, 'description') || '').slice(0, 155) %>" />
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/nav') %>
  <main>
    <div class="project-page">
      <div class="project-info">
        <a href="/" class="project-back"><%= t('project.back') %></a>
        <h1><%= pick(project, 'titre') %></h1>
        <% if (pick(project, 'sous_titre')) { %>
          <div class="subtitle"><%= pick(project, 'sous_titre') %></div>
        <% } %>
        <% if (pick(project, 'description')) { %>
          <div class="description"><%= pick(project, 'description') %></div>
        <% } %>
      </div>

      <div class="project-gallery-wrap" id="galleryWrap">
        <div class="project-gallery" id="gallery">
          <% if (gallery && gallery.length > 0) { %>
            <% gallery.forEach((img) => { %>
              <figure>
                <img src="<%= img.url %>" alt="<%= pick(project, 'titre') %>" loading="lazy" />
              </figure>
            <% }) %>
          <% } %>
        </div>

        <% if (gallery && gallery.length > 1) { %>
          <button class="gallery-arrow prev" aria-label="<%= t('gallery.prev') %>">←</button>
          <button class="gallery-arrow next" aria-label="<%= t('gallery.next') %>">→</button>
          <div class="gallery-nav">
            <% gallery.forEach((_, i) => { %>
              <span class="gallery-dot <%= i === 0 ? 'active' : '' %>"></span>
            <% }) %>
          </div>
        <% } %>
      </div>
    </div>
  </main>
  <script src="/js/gallery.js"></script>
</body>
</html>
