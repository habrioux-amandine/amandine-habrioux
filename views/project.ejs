<!DOCTYPE html>
<html lang="fr">
<head>
  <title><%= project.titre %> — Amandine Habrioux</title>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/nav') %>
  <main>
    <div class="project-page">
      <div class="project-info">
        <a href="/" class="project-back">← Tous les projets</a>
        <h1><%= project.titre %></h1>
        <% if (project.sous_titre) { %>
          <div class="subtitle"><%= project.sous_titre %></div>
        <% } %>
        <% if (project.description) { %>
          <div class="description"><%= project.description %></div>
        <% } %>
      </div>

      <div class="project-gallery-wrap" id="galleryWrap">
        <div class="project-gallery" id="gallery">
          <% if (gallery && gallery.length > 0) { %>
            <% gallery.forEach((img) => { %>
              <figure>
                <img src="<%= img.url %>" alt="<%= project.titre %>" loading="lazy" />
              </figure>
            <% }) %>
          <% } %>
        </div>

        <% if (gallery && gallery.length > 1) { %>
          <button class="gallery-arrow prev" aria-label="Image précédente">←</button>
          <button class="gallery-arrow next" aria-label="Image suivante">→</button>
          <div class="gallery-nav">
            <% gallery.forEach((_, i) => { %>
              <span class="gallery-dot <%= i === 0 ? 'active' : '' %>"></span>
            <% }) %>
          </div>
        <% } %>
      </div>
    </div>
  </main>
  <script src="/js/gallery.js"></script>
</body>
</html>
