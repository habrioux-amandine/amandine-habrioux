<!DOCTYPE html>
<html lang="fr">
<head>
  <title>Profil — Amandine Habrioux</title>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/nav') %>
  <main>
    <div class="profile-page">
      <% if (profile.photo_url) { %>
        <img class="profile-photo" src="<%= profile.photo_url %>" alt="Portrait" />
      <% } %>
     <div class="profile-text"><%= profile.texte || '' %></div>

      <% if (experiences && experiences.length) { %>
        <ul class="experience-timeline">
          <% experiences.forEach((exp) => { %>
            <li>
              <span class="experience-period"><%= exp.periode || '' %></span>
              <div class="experience-body">
                <h3 class="experience-poste"><%= exp.poste %></h3>
                <% if (exp.structure) { %><p class="experience-structure"><%= exp.structure %></p><% } %>
                <% if (exp.description) { %><p class="experience-description"><%= exp.description %></p><% } %>
              </div>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </div>
  </main>
</body>
</html>
