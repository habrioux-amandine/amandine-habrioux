<!DOCTYPE html>
<html lang="fr">
<head>
  <title>Profil — Amandine Habrioux</title>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/nav') %>
  <main>
    <div class="profile-page">
      <% if (profile.photo_url) { %>
        <img class="profile-photo" src="<%= profile.photo_url %>" alt="Portrait" />
      <% } %>
      <div class="profile-text"><%= profile.texte || '' %></div>
    </div>
  </main>
</body>
</html>
