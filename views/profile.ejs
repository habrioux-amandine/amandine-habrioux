<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <title><%= t('meta.profile.title') %></title>
  <meta name="description" content="<%= t('meta.profile.desc') %>" />
<meta property="og:type" content="profile" />
  <meta property="og:url" content="https://amandine-habrioux.onrender.com/profil" />
  <meta property="og:title" content="<%= t('meta.profile.title') %>" />
  <meta property="og:description" content="<%= t('meta.profile.desc') %>" />
  <meta property="og:image" content="<%= profile.photo_url || 'https://amandine-habrioux.onrender.com/images/og-default.png' %>" />
  <meta name="twitter:card" content="summary_large_image" />
  <script type="application/ld+json">
  <%- JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Amandine Habrioux",
    "jobTitle": "Architecte",
    "description": (pick(profile, 'texte') || '').slice(0, 300),
    "url": "https://amandine-habrioux.onrender.com/profil"
  }) %>
  </script>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/nav') %>
  <main>
    <div class="profile-page">
      <% if (profile.photo_url) { %>
        <img class="profile-photo" src="<%= profile.photo_url %>" alt="Portrait" />
      <% } %>
     <div class="profile-text"><%= pick(profile, 'texte') %></div>

      <% if (experiences && experiences.length) { %>
        <ul class="experience-timeline">
          <% experiences.forEach((exp) => { %>
            <li>
              <span class="experience-period"><%= pick(exp, 'periode') %></span>
              <div class="experience-body">
                <h3 class="experience-poste"><%= pick(exp, 'poste') %></h3>
                <% if (pick(exp, 'structure')) { %><p class="experience-structure"><%= pick(exp, 'structure') %></p><% } %>
                <% if (pick(exp, 'description')) { %><p class="experience-description"><%= pick(exp, 'description') %></p><% } %>
              </div>
            </li>
          <% }) %>
        </ul>
      <% } %>
<% if (logiciels && logiciels.length) { %>
        <div class="skills-section">
          <h2 class="skills-title"><%= t('skills.title') %></h2>
          <table class="skills-table">
            <thead>
              <tr>
                <th><%= t('skills.software') %></th>
                <th><%= t('skills.level') %></th>
              </tr>
            </thead>
            <tbody>
              <% logiciels.forEach((log) => { %>
                <tr>
                  <td><%= log.nom %></td>
                  <td>
                    <span class="skill-level skill-level-<%= log.niveau %>">
                      <% for (let i = 1; i <= 4; i++) { %><span class="skill-dot <%= i <= log.niveau ? 'filled' : '' %>"></span><% } %>
                    </span>
                    <span class="skill-level-label"><%= t('niveau.' + log.niveau) %></span>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </main>
</body>
</html>
