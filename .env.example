# URL et clés de ton projet Supabase (Project Settings > API)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJxxxxx...
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxx...

# Nom du bucket Supabase Storage créé pour héberger les images
SUPABASE_STORAGE_BUCKET=site-images

# Environnement
NODE_ENV=production
PORT=3000
